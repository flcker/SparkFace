new file mode 100644
index 0000000..23d7e5f
--- /dev/null
+++ b/VirtualCameraMediaSource/FallbackFrameSource.h
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: Apache-2.0
+// SparkFace Phase-0 B2 adapter for the Microsoft Windows-Camera sample.
+#pragma once
+
+#include <Windows.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace SparkFaceFallback
+{
+    constexpr std::uint32_t Width = 1920;
+    constexpr std::uint32_t Height = 1080;
+    constexpr std::size_t FrameBytes = static_cast<std::size_t>(Width) * Height * 3 / 2;
+    constexpr std::uint32_t SlotCount = 3;
+    constexpr wchar_t RingFilePath[] = L"C:\\Users\\Public\\SparkFacePhase0B2Ring.bin";
+    constexpr wchar_t ModeFilePath[] = L"C:\\Users\\Public\\SparkFacePhase0B2Mode.txt";
+    constexpr std::uint32_t Magic = 0x32424653U;
+    constexpr std::uint32_t Version = 1;
+
+    constexpr std::size_t ProducerQpcOffset = 16;
+    constexpr std::size_t SourceCopyCompleteQpcOffset = 24;
+    constexpr std::size_t PublishedQpcOffset = 32;
+    constexpr std::size_t RequestEntryQpcOffset = 40;
+    constexpr std::size_t SequenceAcquiredQpcOffset = 48;
+    constexpr std::size_t CopyCompleteQpcOffset = 56;
+    constexpr std::size_t SamplePayloadFinalizedQpcOffset = 64;
+    constexpr std::size_t DiagnosticBytes = SamplePayloadFinalizedQpcOffset + sizeof(std::int64_t);
+
+    struct alignas(64) RingHeader
+    {
+        std::uint32_t magic;
+        std::uint32_t version;
+        std::uint32_t width;
+        std::uint32_t height;
+        std::uint32_t frameBytes;
+        std::uint32_t slotCount;
+        std::int64_t qpcFrequency;
+        volatile LONG64 publishedSequence;
+        std::byte reserved[16];
+    };
+
+    struct alignas(64) SlotHeader
+    {
+        volatile LONG64 sequence;
+        std::int64_t producerQpc;
+        std::int64_t publishedQpc;
+        std::byte reserved[40];
+    };
+
+    constexpr std::size_t AlignUp(std::size_t value, std::size_t alignment)
+    {
+        return (value + alignment - 1) & ~(alignment - 1);
+    }
+
+    constexpr std::size_t HeaderBytes = AlignUp(sizeof(RingHeader), 64);
+    constexpr std::size_t SlotBytes = AlignUp(sizeof(SlotHeader) + FrameBytes, 64);
+    constexpr std::size_t MappingBytes = HeaderBytes + SlotCount * SlotBytes;
+
+    enum class PacingMode
+    {
+        WaitForNextSequence,
+        ImmediateLatest,
+    };
+
+    class FrameSource
+    {
+    public:
+        FrameSource() = default;
+        ~FrameSource()
+        {
+            if (m_view != nullptr)
+            {
+                UnmapViewOfFile(m_view);
+            }
+            if (m_mapping != nullptr)
+            {
+                CloseHandle(m_mapping);
+            }
+            if (m_file != nullptr)
+            {
+                CloseHandle(m_file);
+            }
+        }
+
+        FrameSource(const FrameSource&) = delete;
+        FrameSource& operator=(const FrameSource&) = delete;
+
+        void FinalizeSamplePayload(BYTE* destination, DWORD length)
+        {
+            if (destination == nullptr || length < DiagnosticBytes)
+            {
+                return;
+            }
+            LARGE_INTEGER finalized{};
+            QueryPerformanceCounter(&finalized);
+            WriteQpc(destination, SamplePayloadFinalizedQpcOffset, finalized.QuadPart);
+        }
+
+        HRESULT CopyLatestOrBlack(BYTE* destination, DWORD length, LONG pitch,
+            std::int64_t requestEntryQpc)
+        {
+            if (destination == nullptr || pitch <= 0 ||
+                length < static_cast<DWORD>(pitch) * Height * 3 / 2)
+            {
+                return E_INVALIDARG;
+            }
+
+            if (!EnsureOpen())
+            {
+                Sleep(33);
+                FillBlack(destination, pitch);
+                return S_OK;
+            }
+
+            auto* header = static_cast<const RingHeader*>(m_view);
+            auto* published = const_cast<volatile LONG64*>(&header->publishedSequence);
+            LARGE_INTEGER now{};
+            LONG64 latest = InterlockedCompareExchange64(published, 0, 0);
+            if (m_mode == PacingMode::WaitForNextSequence)
+            {
+                LARGE_INTEGER waitStart{};
+                QueryPerformanceCounter(&waitStart);
+                while (latest == m_lastSequence || latest <= 0)
+                {
+                    QueryPerformanceCounter(&now);
+                    if ((now.QuadPart - waitStart.QuadPart) * 1000 >=
+                        header->qpcFrequency * 35)
+                    {
+                        break;
+                    }
+                    Sleep(1);
+                    latest = InterlockedCompareExchange64(published, 0, 0);
+                }
+            }
+            if (latest <= 0)
+            {
+                FillBlack(destination, pitch);
+                return S_OK;
+            }
+
+            const std::uint32_t index = static_cast<std::uint32_t>(latest % SlotCount);
+            const auto* base = static_cast<const std::byte*>(m_view);
+            const auto* slot = reinterpret_cast<const SlotHeader*>(
+                base + HeaderBytes + static_cast<std::size_t>(index) * SlotBytes);
+            auto* slotSequence = const_cast<volatile LONG64*>(&slot->sequence);
+            const LONG64 before = InterlockedCompareExchange64(slotSequence, 0, 0);
+            QueryPerformanceCounter(&now);
+            const bool stale = slot->publishedQpc <= 0 ||
+                (now.QuadPart - slot->publishedQpc) * 1000 > header->qpcFrequency * 66;
+            if (before != latest)
+            {
+                FillBlack(destination, pitch);
+                return S_OK;
+            }
+            if (stale)
+            {
+                m_lastSequence = latest;
+                FillBlack(destination, pitch);
+                return S_OK;
+            }
+
+            LARGE_INTEGER acquired{};
+            QueryPerformanceCounter(&acquired);
+            const auto* payload = reinterpret_cast<const BYTE*>(slot) + sizeof(SlotHeader);
+            for (std::uint32_t row = 0; row < Height; ++row)
+            {
+                std::memcpy(destination + static_cast<std::size_t>(row) * pitch,
+                    payload + static_cast<std::size_t>(row) * Width, Width);
+            }
+            BYTE* destinationUv = destination + static_cast<std::size_t>(pitch) * Height;
+            const BYTE* sourceUv = payload + static_cast<std::size_t>(Width) * Height;
+            for (std::uint32_t row = 0; row < Height / 2; ++row)
+            {
+                std::memcpy(destinationUv + static_cast<std::size_t>(row) * pitch,
+                    sourceUv + static_cast<std::size_t>(row) * Width, Width);
+            }
+            MemoryBarrier();
+            const LONG64 after = InterlockedCompareExchange64(slotSequence, 0, 0);
+            if (before != after)
+            {
+                FillBlack(destination, pitch);
+            }
+            else
+            {
+                LARGE_INTEGER copyComplete{};
+                QueryPerformanceCounter(&copyComplete);
+                if (length >= DiagnosticBytes)
+                {
+                    WriteQpc(destination, SourceCopyCompleteQpcOffset, copyComplete.QuadPart);
+                    WriteQpc(destination, PublishedQpcOffset, slot->publishedQpc);
+                    WriteQpc(destination, RequestEntryQpcOffset, requestEntryQpc);
+                    WriteQpc(destination, SequenceAcquiredQpcOffset, acquired.QuadPart);
+                    WriteQpc(destination, CopyCompleteQpcOffset, copyComplete.QuadPart);
+                }
+                m_lastSequence = after;
+            }
+            return S_OK;
+        }
+
+    private:
+        static void WriteQpc(BYTE* destination, std::size_t offset, std::int64_t value)
+        {
+            std::memcpy(destination + offset, &value, sizeof(value));
+        }
+
+        void ReadPacingModeOnce()
+        {
+            HANDLE modeFile = CreateFileW(ModeFilePath, GENERIC_READ,
+                FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+                FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (modeFile == INVALID_HANDLE_VALUE)
+            {
+                return;
+            }
+            char value[16]{};
+            DWORD bytesRead = 0;
+            if (ReadFile(modeFile, value, sizeof(value) - 1, &bytesRead, nullptr) &&
+                bytesRead >= 9 && std::memcmp(value, "immediate", 9) == 0)
+            {
+                m_mode = PacingMode::ImmediateLatest;
+            }
+            CloseHandle(modeFile);
+        }
+
+        bool EnsureOpen()
+        {
+            if (m_view != nullptr)
+            {
+                return true;
+            }
+            if (!m_modeRead)
+            {
+                ReadPacingModeOnce();
+                m_modeRead = true;
+            }
+            m_file = CreateFileW(RingFilePath, GENERIC_READ | GENERIC_WRITE,
+                FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+                FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (m_file == INVALID_HANDLE_VALUE)
+            {
+                m_file = nullptr;
+                return false;
+            }
+            m_mapping = CreateFileMappingW(m_file, nullptr, PAGE_READWRITE, 0, 0, nullptr);
+            if (m_mapping == nullptr)
+            {
+                CloseHandle(m_file);
+                m_file = nullptr;
+                return false;
+            }
+            m_view = MapViewOfFile(m_mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, MappingBytes);
+            if (m_view == nullptr)
+            {
+                CloseHandle(m_mapping);
+                CloseHandle(m_file);
+                m_mapping = nullptr;
+                m_file = nullptr;
+                return false;
+            }
+            const auto* header = static_cast<const RingHeader*>(m_view);
+            if (header->magic != Magic || header->version != Version ||
+                header->width != Width || header->height != Height ||
+                header->frameBytes != FrameBytes || header->slotCount != SlotCount)
+            {
+                UnmapViewOfFile(m_view);
+                CloseHandle(m_mapping);
+                CloseHandle(m_file);
+                m_view = nullptr;
+                m_mapping = nullptr;
+                m_file = nullptr;
+                return false;
+            }
+            return true;
+        }
+
+        static void FillBlack(BYTE* destination, LONG pitch)
+        {
+            for (std::uint32_t row = 0; row < Height; ++row)
+            {
+                std::memset(destination + static_cast<std::size_t>(row) * pitch, 16, Width);
+            }
+            BYTE* uv = destination + static_cast<std::size_t>(pitch) * Height;
+            for (std::uint32_t row = 0; row < Height / 2; ++row)
+            {
+                std::memset(uv + static_cast<std::size_t>(row) * pitch, 128, Width);
+            }
+        }
+
+        HANDLE m_file = nullptr;
+        HANDLE m_mapping = nullptr;
+        void* m_view = nullptr;
+        LONG64 m_lastSequence = 0;
+        PacingMode m_mode = PacingMode::WaitForNextSequence;
+        bool m_modeRead = false;
+    };
+}
